{
  "name": "nd-server-upload",
  "version": "1.0.0",
  "description": "A small server tool to easily upload songs to Navidrome without SSH/FTP",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "pnpm --filter client dev",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "pnpm --filter client build",
    "build": "pnpm build:server && pnpm build:client",
    "start": "node dist/server.js",
    "test": "echo \"No tests specified\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "multer": "^2.1.1",
    "music-metadata": "^12.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
